<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>CreCraftStudios.HunterReborn.Launcher</RootNamespace>
    <AssemblyName>Hunter Reborn Launcher</AssemblyName>
    <Title>Hunter Reborn Launcher</Title>
    <Authors>CreCraft Studios</Authors>
    <Company>CreCraft Studios</Company>
    <Copyright>(C) Copyright, CreCraft Studios</Copyright>
    <Version>1.1.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <NeutralLanguage>en-AU</NeutralLanguage>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
	  <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	  <ApplicationIcon>hunter reborn logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <None Update="setup.bat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="splash.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

	  <None Include="Nginx\**\*">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Include="Third-party Licenses\**\*">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Remove="Executables\MicrosoftEdgeWebview2Setup.exe" />
	  <Content Include="Executables\MicrosoftEdgeWebview2Setup.exe">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="hunter reborn logo.ico" />

	  <None Update="Nginx\temp\**\*">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>

	  <None Update="Nginx\ssl\**\*">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>

	  <None Update="Nginx\logs\**\*">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
  </ItemGroup>
  
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
	<None Update="Configs/debug.conf">
		<TargetPath>Nginx/conf/nginx.conf</TargetPath>
		<CopyToOutputDirectory>Always</CopyToOutputDirectory>
	</None>
  </ItemGroup>
  
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
	<None Update="Configs/release.conf">
		<TargetPath>Nginx/conf/nginx.conf</TargetPath>
		<CopyToOutputDirectory>Always</CopyToOutputDirectory>
	</None>
  </ItemGroup>

</Project>